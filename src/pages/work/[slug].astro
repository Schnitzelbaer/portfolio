---
import { Image } from "astro:assets";
import { render } from "astro:content";
import KeyFacts from "../../components/blocks/KeyFacts.astro";
import { blocks } from "../../components/blocks/registry";
import Base from "../../layouts/Base.astro";
import { getWork, type WorkEntry } from "../../lib/work";

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: WorkEntry;
}
const { entry } = Astro.props;
const { data } = entry;
// Locked case studies never render their body into static output. Phase (e) moves them behind
// the server-side gate.
const Content = data.locked ? null : (await render(entry)).Content;
---

<Base title={data.title} description={data.lead} noindex={data.locked}>
  <article>
    <h1>{data.title}</h1>
    <p>{data.lead}</p>
    <KeyFacts {...data.keyFacts} />
    <Image src={data.cover} alt={data.coverAlt} widths={[800, 1600]} sizes="(min-width: 760px) 680px, 100vw" loading="eager" />
    {Content ? <Content components={blocks} /> : <p>This case study is password protected.</p>}
  </article>
</Base>
