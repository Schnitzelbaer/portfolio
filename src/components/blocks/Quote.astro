---
/** Pull quote with attribution, e.g. from user research or a stakeholder. */
interface Props {
  author?: string;
  role?: string;
}
const { author, role } = Astro.props;
---

<figure class="block quote">
  <blockquote><slot /></blockquote>
  {
    author && (
      <figcaption class="quote__by">
        <span class="quote__author">{author}</span>
        {role && <span class="mono">{role}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .quote {
    padding: 0.25rem 0 0.25rem 1.25rem;
    border-left: 2px solid var(--accent);
  }
  blockquote {
    color: var(--text);
    font-size: var(--text-lg);
    line-height: 1.5;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  blockquote :global(p) {
    quotes: "“" "”";
  }
  blockquote :global(p)::before {
    content: open-quote;
  }
  blockquote :global(p)::after {
    content: close-quote;
  }
  .quote__by {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.625rem;
    margin-top: 0.75rem;
  }
  .quote__author {
    color: var(--text-muted);
    font-size: var(--text-ui);
    font-weight: 500;
  }
</style>
