---
/**
 * Key figures as large numbers, for `<Stat>` children:
 *   <Stats>
 *     <Stat value="~100" label="Components" note="Each in two to four sizes" />
 *   </Stats>
 */
interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<section class="block stats" aria-label={title ?? "Key figures"}>
  <dl class="stats__grid"><slot /></dl>
</section>

<style>
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.5rem;
    margin: 0;
  }
</style>
