---
import Icon from "./Icon.astro";

/**
 * Fixed corner controls like the reference: agent switch bottom left, theme toggle and
 * "updated" stamp bottom right. On small screens they sit at the end of the page instead.
 */
interface Props {
  agentHref?: string | undefined;
  agentActive?: boolean;
}
const { agentHref, agentActive = false } = Astro.props;
const builtAt = new Date().toISOString();
---

<footer class="footer">
  <div class="footer__start">
    {
      agentHref && (
        <a class="switch mono" href={agentHref} data-on={agentActive ? "true" : "false"} aria-label={agentActive ? "For agents: on. Back to the regular version" : "For agents: agent-friendly version of this page"}>
          <span>For agents</span>
          <span class="switch__track" aria-hidden="true">
            <span class="switch__thumb" />
          </span>
        </a>
      )
    }
  </div>
  <div class="footer__end mono">
    <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to light theme">
      <Icon name="sun" size={13} class="theme-toggle__light" />
      <Icon name="moon" size={13} class="theme-toggle__dark" />
      <span class="theme-toggle__text">Light</span>
    </button>
    <span aria-hidden="true">·</span>
    <span>Updated <time datetime={builtAt} data-relative>{builtAt.slice(0, 10)}</time></span>
  </div>
</footer>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const sync = () => {
      const light = root.dataset.theme === "light";
      for (const button of document.querySelectorAll("[data-theme-toggle]")) {
        button.setAttribute("aria-label", light ? "Switch to dark theme" : "Switch to light theme");
        const text = button.querySelector(".theme-toggle__text");
        if (text) text.textContent = light ? "Dark" : "Light";
      }
    };
    document.addEventListener("click", (event) => {
      const button = event.target instanceof Element && event.target.closest("[data-theme-toggle]");
      if (!button) return;
      const next = root.dataset.theme === "light" ? "dark" : "light";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {}
      sync();
    });
    sync();
    const time = document.querySelector("time[data-relative]");
    if (time) {
      const minutes = Math.max(0, (Date.now() - Date.parse(time.dateTime)) / 60000);
      const units = [
        [60 * 24 * 365, "y"],
        [60 * 24 * 30, "mo"],
        [60 * 24, "d"],
        [60, "h"],
        [1, "m"],
      ];
      const [size, unit] = units.find(([s]) => minutes >= s) || [1, "m"];
      time.textContent = `${Math.max(1, Math.floor(minutes / size))}${unit} ago`;
    }
  })();
</script>

<style>
  .footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    /* At the end of the page the controls sit above the bottom fade (and the mobile nav). */
    padding: 4rem var(--gutter) calc(var(--edge-bottom) + 0.5rem);
  }
  .footer__end {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  @media (min-width: 48rem) {
    .footer {
      position: fixed;
      inset: auto 0 0;
      z-index: 20;
      padding: 0 1.5rem 1.25rem;
      pointer-events: none;
    }
    .footer > * {
      pointer-events: auto;
    }
  }
  .switch {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--text-subtle);
    transition: color var(--duration-fast) var(--ease-out);
  }
  .switch:hover {
    color: var(--text);
  }
  .switch__track {
    position: relative;
    width: 1.375rem;
    height: 0.8125rem;
    border-radius: var(--radius-pill);
    background: var(--surface-strong);
    border: 1px solid var(--border-strong);
    transition: background var(--duration) var(--ease-out);
  }
  .switch__thumb {
    position: absolute;
    top: 1px;
    left: 1px;
    width: 0.5625rem;
    height: 0.5625rem;
    border-radius: 50%;
    background: var(--text);
    transition: transform var(--duration) var(--ease-spring);
  }
  .switch[data-on="true"] .switch__track {
    background: var(--accent);
    border-color: var(--accent);
  }
  .switch[data-on="true"] .switch__thumb {
    transform: translateX(0.5625rem);
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--text-subtle);
    text-transform: uppercase;
    letter-spacing: inherit;
    font-size: inherit;
    font-family: inherit;
    padding: 0.25rem 0;
    transition: color var(--duration-fast) var(--ease-out);
  }
  .theme-toggle:hover {
    color: var(--text);
  }
  .theme-toggle :global(.theme-toggle__dark),
  :global([data-theme="light"]) .theme-toggle :global(.theme-toggle__light) {
    display: none;
  }
  :global([data-theme="light"]) .theme-toggle :global(.theme-toggle__dark) {
    display: block;
  }
</style>
