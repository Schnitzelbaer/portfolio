---
import { Image } from "astro:assets";
import { coverVideo } from "../lib/cover-video";
import type { WorkEntry } from "../lib/work";
import Icon from "./Icon.astro";
import VideoToggle from "./VideoToggle.astro";

interface Props {
  entry: WorkEntry;
  index: number;
  /** The first cards are above the fold on desktop; load them eagerly for LCP. */
  eager?: boolean;
}
const { entry, index, eager = false } = Astro.props;
const { title, cover, coverAlt, keyFacts, outcome, locked } = entry.data;
// A card with a cover video plays its small encode in place of the image (poster).
const video = coverVideo(entry.id)?.card;
const sources = video && JSON.stringify({ desktop: video, mobile: {} });
---

<li
  class:list={["card reveal", { "card--video": video }]}
  style={`--i: ${index + 2}`}
  data-video-demo={video ? "" : undefined}
  data-sources={sources}
>
  <a href={`/work/${entry.id}`} class="card__link">
    <div class="card__media">
      <Image
        src={cover}
        alt={coverAlt}
        widths={[480, 720, 992, 1280]}
        sizes="(min-width: 560px) 496px, calc(100vw - 48px)"
        loading={eager ? "eager" : "lazy"}
        fetchpriority={index === 0 ? "high" : "auto"}
      />
      {
        video && (
          <video
            class="card__video"
            muted
            loop
            playsinline
            webkit-playsinline
            preload="none"
            disablepictureinpicture
            disableRemotePlayback
            aria-hidden="true"
          />
        )
      }
      {
        locked && (
          <span class="card__badge mono">
            <Icon name="lock" size={12} />
            Protected
          </span>
        )
      }
    </div>
    <div class="card__body">
      <h2 class="card__title">
        {title}
        {locked && <Icon name="lock" size={15} class="card__lock" label="Password protected" />}
      </h2>
      <p class="card__role mono">{keyFacts.role}</p>
      <p class="card__outcome">{outcome}</p>
    </div>
  </a>
  {video && <VideoToggle />}
</li>

<script>
  import { initVideoDemos } from "../lib/video-demo";

  initVideoDemos();
</script>

<style>
  .card--video {
    position: relative;
    container-type: inline-size;
  }
  /* The play/pause button sits on the media, outside the link (no nested controls). */
  .card--video :global(.video-toggle) {
    top: calc(100cqw * 9 / 16 - 3.5rem);
    bottom: auto;
  }
  .card__link {
    display: block;
    border-radius: var(--radius-lg);
  }
  .card__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--surface);
    aspect-ratio: 4 / 3;
    isolation: isolate;
  }
  .card--video .card__media {
    aspect-ratio: 16 / 9;
  }
  .card__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }
  /* The poster image lies on top and fades out once the video plays (see Video.astro). */
  .card--video .card__media :global(img) {
    position: relative;
    z-index: 1;
    transition:
      opacity var(--duration) var(--ease-out),
      transform var(--duration-slow) var(--ease-out);
  }
  .card--video[data-started="true"] .card__media :global(img) {
    opacity: 0;
  }
  .card__link:hover .card__video {
    transform: scale(1.025);
  }
  .card__media::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.06);
    pointer-events: none;
  }
  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }
  .card__link:hover .card__media :global(img) {
    transform: scale(1.025);
  }
  .card__badge {
    position: absolute;
    z-index: 2;
    top: 0.75rem;
    left: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius-pill);
    background: rgb(23 22 29 / 0.72);
    color: #ececf1;
    backdrop-filter: blur(8px);
  }
  .card__body {
    padding: 1rem 0.25rem 0;
  }
  .card__title {
    font-size: var(--text-md);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .card__title :global(.card__lock) {
    display: inline-block;
    margin-left: 0.4em;
    vertical-align: -0.1em;
    color: var(--text-muted);
  }
  .card__role {
    margin-top: 0.375rem;
  }
  .card__outcome {
    margin-top: 0.375rem;
    color: var(--text-muted);
    font-size: var(--text-ui);
    line-height: 1.5;
  }
  .card__link:hover .card__title {
    color: var(--text-strong);
  }
</style>
