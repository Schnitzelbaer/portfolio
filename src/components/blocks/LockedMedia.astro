---
import { IMAGE_FORMATS, privateManifest } from "../../lib/private-assets";
import Icon from "../Icon.astro";

/**
 * Image that lives behind the password gate. For unlocked visitors it renders a responsive
 * picture served by `/protected/img/*`; otherwise a neutral stand-in. The original file is never
 * part of the public build.
 */
interface Props {
  id: string;
  alt: string;
  sizes?: string;
}
const { id, alt, sizes = "(min-width: 688px) 640px, calc(100vw - 48px)" } = Astro.props;
const image = Astro.locals.unlocked ? privateManifest().images[id] : undefined;
const srcset = (format: string) =>
  image?.widths.map((w) => `/protected/img/${id}-${w}.${format} ${w}w`).join(", ") ?? "";
const fallbackWidth = image?.widths.find((w) => w >= 800) ?? image?.widths.at(-1);
---

{
  image ? (
    <picture>
      {IMAGE_FORMATS.map((format) => (
        <source type={`image/${format}`} srcset={srcset(format)} sizes={sizes} />
      ))}
      <img src={`/protected/img/${id}-${fallbackWidth}.webp`} alt={alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
    </picture>
  ) : (
    <div class="locked-media" role="img" aria-label={`Protected image: ${alt}`}>
      <Icon name="lock" size={18} />
    </div>
  )
}

<style>
  .locked-media {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    color: var(--text-subtle);
    background:
      repeating-linear-gradient(135deg, transparent 0 10px, color-mix(in srgb, var(--border) 60%, transparent) 10px 11px),
      var(--surface);
  }
</style>
