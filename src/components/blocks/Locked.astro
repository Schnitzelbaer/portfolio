---
import Icon from "../Icon.astro";
import UnlockForm from "../UnlockForm.astro";

/**
 * Section that is only visible after entering the password. Its content is rendered only on the
 * server for unlocked visitors; pages containing it are rendered on demand (never prerendered).
 */
interface Props {
  title?: string;
}
const { title = "Protected section" } = Astro.props;
const unlocked = Astro.locals.unlocked === true;
---

{
  unlocked ? (
    <section class="block locked-open" aria-label={title}>
      <p class="locked-open__label mono">
        <Icon name="unlock" size={12} />
        {title}
      </p>
      <div class="locked-open__body">
        <slot />
      </div>
    </section>
  ) : (
    <div class="block">
      <UnlockForm title={title} anchor={false} />
    </div>
  )
}

<style>
  .locked-open {
    padding-top: 1rem;
    border-top: 1px dashed var(--border-strong);
  }
  .locked-open__label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .locked-open__body {
    margin-top: 0.75rem;
  }
  .locked-open__body > :global(* + *) {
    margin-top: 1rem;
  }
</style>
