---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import LockedMedia from "./LockedMedia.astro";

/** One side of a `<Compare>`, e.g. "Before", "After" or "Variant B". */
interface Props {
  label: string;
  src?: ImageMetadata;
  privateId?: string;
  alt: string;
}
const { label, src, privateId, alt } = Astro.props;
---

<div class="compare__variant">
  <p class="compare__label">{label}</p>
  {
    src ? (
      <Picture src={src} alt={alt} formats={["avif", "webp"]} widths={[400, 800, 1200].filter((w) => w <= src.width)} sizes="(min-width: 760px) 340px, 100vw" />
    ) : privateId ? (
      <LockedMedia id={privateId} alt={alt} />
    ) : null
  }
</div>
