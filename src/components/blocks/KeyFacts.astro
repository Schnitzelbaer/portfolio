---
import type { ImageMetadata } from "astro";

/**
 * Key facts from the case study frontmatter, as dotted leader rows, client first.
 * Period, tools and a small client logo (shown before the client name) are optional.
 */
interface Props {
  role: string;
  client: string;
  team: string;
  status: string;
  period?: string | undefined;
  tools?: string | undefined;
  clientLogo?: ImageMetadata | undefined;
}
const { role, client, team, status, period, tools, clientLogo } = Astro.props;
const rows: Array<[string, string | undefined]> = [
  ["Client", client],
  ["Role", role],
  ["Team", team],
  ["Period", period],
  ["Status", status],
  ["Tools", tools],
];
const facts = rows.filter((row): row is [string, string] => Boolean(row[1]));
---

<dl class="key-facts">
  {
    facts.map(([term, value]) => (
      <div class="key-facts__row">
        <dt class="mono">{term}</dt>
        <span class="key-facts__line" aria-hidden="true" />
        <dd>
          {term === "Client" && clientLogo && (
            <img class="key-facts__logo" src={clientLogo.src} width={clientLogo.width} height={clientLogo.height} alt="" />
          )}
          {value}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .key-facts__logo {
    display: inline-block;
    margin-right: 0.375rem;
    vertical-align: -0.0625rem;
  }
  .key-facts {
    display: grid;
    gap: 0.625rem;
    font-size: var(--text-ui);
  }
  .key-facts__row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  dt {
    flex: none;
  }
  .key-facts__line {
    flex: 1 1 1rem;
    min-width: 1rem;
    border-bottom: 1px dotted var(--border-strong);
    transform: translateY(-0.3em);
  }
  dd {
    color: var(--text);
    text-align: right;
    max-width: 70%;
  }
</style>
