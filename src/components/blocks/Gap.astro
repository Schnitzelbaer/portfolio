---
import { isEmptyGap } from "../../lib/content/placeholders";

/**
 * Open spot from the Notion convention: `[...]` or a bracketed note such as a provisional value
 * (`[1890]`) or a reminder. Highlighted in dev; production builds of variants fail while any remain.
 */
interface Props {
  note?: string;
}
const { note = "..." } = Astro.props;
const dev = import.meta.env.DEV;
const text = isEmptyGap(note) ? "[…]" : `[${note}]`;
---

{
  dev ? (
    <mark class="gap" data-draft="gap" title="Open placeholder">
      {text}
    </mark>
  ) : (
    <span class="gap-plain">{text}</span>
  )
}

<style>
  .gap {
    padding: 0 0.3em;
    border-radius: 4px;
    background: var(--draft-surface);
    color: var(--draft);
    outline: 1px dashed var(--draft);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
</style>
