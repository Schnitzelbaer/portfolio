---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import { privateManifest } from "../../lib/private-assets";
import VideoToggle from "../VideoToggle.astro";

/**
 * Pre-produced demo video: muted, looping, inline autoplay while visible, one play/pause
 * button, no native controls or timeline. Behaviour lives in src/lib/video-demo.ts.
 *
 * In MDX, paths are relative to the case study:
 *   <Video src="./videos/flow.mp4" webm="./videos/flow.webm"
 *          mobileSrc="./videos/flow-mobile.mp4" mobileWebm="./videos/flow-mobile.webm"
 *          poster="./videos/flow.jpg" mobilePoster="./videos/flow-mobile.jpg"
 *          alt="What the video shows" caption="Optional caption" />
 * The content pipeline turns the paths into published files, or into gated URLs and private ids
 * inside locked content. `aspect` / `mobileAspect` (e.g. "16/10") default to the posters' sizes.
 */
interface Props {
  src: string;
  webm?: string;
  mobileSrc?: string;
  mobileWebm?: string;
  poster?: ImageMetadata;
  posterPrivateId?: string;
  mobilePoster?: ImageMetadata;
  mobilePosterPrivateId?: string;
  aspect?: string;
  mobileAspect?: string;
  alt: string;
  caption?: string;
  /** Poster `sizes`; defaults to the case study column. */
  sizes?: string;
  /** Load the poster eagerly (video at the top of a page, LCP candidate). */
  eager?: boolean;
}

const {
  src,
  webm,
  mobileSrc,
  mobileWebm,
  poster,
  posterPrivateId,
  mobilePoster,
  mobilePosterPrivateId,
  alt,
  caption,
  eager = false,
} = Astro.props;

interface PosterSource {
  src: string;
  srcset: string;
  width: number;
  height: number;
}

async function posterSource(image?: ImageMetadata, privateId?: string): Promise<PosterSource | undefined> {
  if (image) {
    const widths = [480, 800, 1200, 1600].filter((w) => w <= image.width);
    const result = await getImage({ src: image, format: "webp", widths: widths.length ? widths : [image.width] });
    return { src: result.src, srcset: result.srcSet.attribute, width: image.width, height: image.height };
  }
  const meta = privateId && Astro.locals.unlocked ? privateManifest().images[privateId] : undefined;
  if (!privateId || !meta) return undefined;
  const fallback = meta.widths.find((w) => w >= 800) ?? meta.widths.at(-1);
  return {
    src: `/protected/img/${privateId}-${fallback}.webp`,
    srcset: meta.widths.map((w) => `/protected/img/${privateId}-${w}.webp ${w}w`).join(", "),
    width: meta.width,
    height: meta.height,
  };
}

const desktopPoster = await posterSource(poster, posterPrivateId);
const mobilePosterSource = await posterSource(mobilePoster, mobilePosterPrivateId);

const ratio = (value: string | undefined, fallback?: PosterSource) => {
  const match = /^\s*(\d+(?:\.\d+)?)\s*[/:x]\s*(\d+(?:\.\d+)?)\s*$/.exec(value ?? "");
  if (match) return `${match[1]} / ${match[2]}`;
  return fallback ? `${fallback.width} / ${fallback.height}` : undefined;
};
const aspect = ratio(Astro.props.aspect, desktopPoster) ?? "16 / 9";
const mobileAspect = ratio(Astro.props.mobileAspect, mobilePosterSource) ?? (mobileSrc || mobileWebm ? undefined : aspect);

const sources = JSON.stringify({
  desktop: { mp4: src, webm },
  mobile: { mp4: mobileSrc, webm: mobileWebm },
});
const style = [`--aspect: ${aspect}`, mobileAspect && `--aspect-mobile: ${mobileAspect}`].filter(Boolean).join("; ");
const sizes = Astro.props.sizes ?? "(min-width: 688px) 640px, calc(100vw - 48px)";
---

<figure class="block video-demo is-wide" data-video-demo data-sources={sources} style={style}>
  <div class="video-demo__frame">
    {
      desktopPoster && (
        <picture class="video-demo__poster">
          {mobilePosterSource && <source media="(max-width: 40rem)" srcset={mobilePosterSource.srcset} sizes={sizes} />}
          <img
            src={desktopPoster.src}
            srcset={desktopPoster.srcset}
            sizes={sizes}
            width={desktopPoster.width}
            height={desktopPoster.height}
            alt=""
            loading={eager ? "eager" : "lazy"}
            fetchpriority={eager ? "high" : "auto"}
            decoding="async"
          />
        </picture>
      )
    }
    <video
      class="video-demo__video"
      muted
      loop
      playsinline
      webkit-playsinline
      preload="none"
      disablepictureinpicture
      disableRemotePlayback
      aria-label={alt}></video>
    <VideoToggle />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  import { initVideoDemos } from "../../lib/video-demo";

  initVideoDemos();
</script>

<style>
  .video-demo__frame {
    position: relative;
    overflow: hidden;
    max-width: 100%;
    aspect-ratio: var(--aspect);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--border);
    isolation: isolate;
  }
  @media (max-width: 40rem) {
    .video-demo__frame {
      aspect-ratio: var(--aspect-mobile, var(--aspect));
    }
  }
  .video-demo__poster,
  .video-demo__poster img,
  .video-demo__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video-demo__video {
    opacity: 0;
    transition: opacity var(--duration) var(--ease-out);
  }
  .video-demo[data-started="true"] .video-demo__video {
    opacity: 1;
  }
</style>
