---
/** Uppercase section label followed by a blinking block cursor, e.g. "EXPERIENCE▮". */
interface Props {
  as?: "h1" | "h2" | "h3" | "p";
  id?: string;
}
const { as: Tag = "h2", id } = Astro.props;
---

<Tag class="section-label" id={id}><slot /><span class="cursor" aria-hidden="true"></span></Tag>

<style>
  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: 1;
  }
  .cursor {
    width: 0.45em;
    height: 1.05em;
    border-radius: 1px;
    background: currentColor;
    opacity: 0.85;
    animation: blink 1.1s steps(1, end) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
