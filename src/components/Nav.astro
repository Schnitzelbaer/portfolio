---
import Icon, { type IconName } from "./Icon.astro";

/**
 * Pill tabs in a frosted bar, sticky at the top. Project pages add a round back button left of the tabs, outside
 * the centred group so the tabs stay in place.
 */
interface Props {
  current: "work" | "about" | undefined;
  /** Target of the back button; no button when unset. */
  back?: string | undefined;
}
const { current, back } = Astro.props;
const items: Array<{ id: "work" | "about"; label: string; href: string; icon: IconName }> = [
  { id: "work", label: "Work", href: "/", icon: "work" },
  { id: "about", label: "About", href: "/about", icon: "about" },
];
---

<nav class="nav" aria-label="Main">
  <div class="nav__bar">
    {
      back && (
        <a class="nav__back" href={back} data-nav-back aria-label="Back to work">
          <Icon name="back" size={18} />
        </a>
      )
    }
    <ul class="nav__tabs" role="list">
      {
        items.map((item) => {
          const active = item.id === current;
          return (
            <li>
              <a href={item.href} class:list={["nav__link", { "is-active": active }]} aria-current={active ? "page" : undefined}>
                {active && <span class="nav__pill" aria-hidden="true" />}
                <span class="nav__content" style={`view-transition-name: nav-${item.id}`}>
                  <Icon name={item.icon} size={16} class="nav__icon" />
                  <span class="nav__label">{item.label}</span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</nav>

<script is:inline>
  // Coming from the list, go back in history so the list keeps its scroll position.
  document.addEventListener("click", (event) => {
    const link = event.target instanceof Element && event.target.closest("[data-nav-back]");
    if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    try {
      const from = new URL(document.referrer);
      const to = new URL(link.href);
      if (from.origin === location.origin && from.pathname === to.pathname && history.length > 1) {
        event.preventDefault();
        history.back();
      }
    } catch {}
  });
</script>

<style>
  .nav {
    --nav-h: 2.75rem;
    display: flex;
    justify-content: center;
  }
  .nav__bar {
    position: relative;
    display: flex;
    pointer-events: auto;
  }
  .nav__tabs,
  .nav__back {
    height: var(--nav-h);
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-elevated) 72%, transparent);
    backdrop-filter: blur(16px) saturate(1.4);
    box-shadow: var(--shadow-pill);
  }
  /* View transitions: the bar, the gliding pill and each tab's label are separate layers,
     painted in this order, so the pill never covers a label mid-transition. */
  .nav__tabs {
    view-transition-name: nav-bar;
    display: flex;
    align-items: center;
    gap: 0.125rem;
    padding: 0 0.25rem;
    border-radius: var(--radius-pill);
  }
  .nav__back {
    position: absolute;
    top: 0;
    right: calc(100% + 0.5rem);
    display: grid;
    place-items: center;
    width: var(--nav-h);
    border-radius: 50%;
    color: var(--text-muted);
    transition: color var(--duration-fast) var(--ease-out);
  }
  .nav__back:hover {
    color: var(--text);
  }
  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: calc(var(--nav-h) - 0.5rem - 2px);
    padding: 0 0.875rem;
    border-radius: var(--radius-pill);
    color: var(--text-muted);
    font-size: var(--text-ui);
    font-weight: 500;
    letter-spacing: -0.005em;
    isolation: isolate;
    transition: color var(--duration-fast) var(--ease-out);
  }
  .nav__link:hover {
    color: var(--text);
  }
  .nav__link.is-active {
    color: var(--text);
  }
  .nav__pill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(to bottom, var(--surface-strong), var(--surface));
    border: 1px solid var(--border);
    box-shadow: var(--shadow-pill);
    view-transition-name: nav-pill;
    z-index: -1;
  }
  .nav__content {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .nav__link :global(.nav__icon) {
    flex: none;
    opacity: 0.9;
  }
  @media (max-width: 40rem) {
    .nav__link {
      padding: 0 1rem;
    }
    .nav__link :global(.nav__icon) {
      width: 18px;
      height: 18px;
    }
  }
</style>
