---
import CaseStudyView from "../../components/CaseStudyView.astro";
import { isGated, pageContext } from "../../lib/page";
import { getWork, type WorkEntry } from "../../lib/work";

/** Public case studies, prerendered. Gated ones are served by `[...gated].astro`. */
export async function getStaticPaths() {
  const work = await getWork();
  return work
    .filter((entry) => !isGated(entry))
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: WorkEntry;
}
const { entry } = Astro.props;
---

<CaseStudyView entry={entry} context={pageContext()} showBody />
