---
import { Image } from "astro:assets";
import { render } from "astro:content";
import type { WorkEntry } from "../lib/work";
import "../styles/prose.css";
import KeyFacts from "./blocks/KeyFacts.astro";
import { blocks } from "./blocks/registry";
import Icon from "./Icon.astro";
import SectionLabel from "./SectionLabel.astro";

/**
 * Case study page body. When `showBody` is false (locked and not unlocked), only the public
 * header is rendered: title, lead, key facts and cover. The body is never rendered then.
 */
interface Props {
  entry: WorkEntry;
  showBody: boolean;
}
const { entry, showBody } = Astro.props;
const { data } = entry;
const Content = showBody ? (await render(entry)).Content : null;
const year = data.date.getFullYear();
---

<article class="case">
  <header class="case__head column">
    <div class="case__eyebrow reveal" style="--i: 0">
      <SectionLabel as="p">Case study</SectionLabel>
      <span class="mono">{year}</span>
    </div>
    <h1 class="case__title reveal" style="--i: 1">
      {data.title}
      {data.locked && <Icon name="lock" size={18} class="case__lock" label="Password protected" />}
    </h1>
    <p class="case__lead reveal" style="--i: 2">{data.lead}</p>
    <div class="case__facts reveal" style="--i: 3"><KeyFacts {...data.keyFacts} /></div>
  </header>

  <div class="case__cover wide reveal" style="--i: 4">
    <div class="media">
      <Image
        src={data.cover}
        alt={data.coverAlt}
        widths={[480, 768, 1152, 1536]}
        sizes="(min-width: 816px) 768px, calc(100vw - 48px)"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>

  {
    Content ? (
      <div class="prose case__body">
        <Content components={blocks} />
      </div>
    ) : (
      <div class="case__gate column">
        <slot name="gate" />
      </div>
    )
  }

</article>

<style>
  /* Body (text and media) in a 640px column; the intro up to the cover is wider (768px). */
  .case {
    --col: 40rem;
    --col-wide: 40rem;
    padding-top: 3.75rem;
  }
  .case__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }
  .case__title {
    margin-top: 1.25rem;
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
  }
  .case__title :global(.case__lock) {
    display: inline-block;
    margin-left: 0.4em;
    vertical-align: -0.08em;
    color: var(--text-muted);
  }
  .case__lead {
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: var(--text-lg);
    line-height: 1.6;
    letter-spacing: -0.01em;
  }
  .case__facts {
    margin-top: 2.5rem;
  }
  .case__head {
    --col: 48rem;
  }
  .case__cover {
    --col-wide: 48rem;
    margin-top: 3rem;
  }
  .case__body {
    margin-top: 1.5rem;
  }
  .case__gate {
    margin-top: 2.5rem;
  }
</style>
