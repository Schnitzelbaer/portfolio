---
/** Before/after or variant comparison. Children are `<Variant>` elements. */
interface Props {
  kind?: "before-after" | "variants";
  caption?: string;
}
const { kind = "before-after", caption } = Astro.props;
---

<figure class="block compare is-wide" data-kind={kind} aria-label={kind === "before-after" ? "Before and after" : "Variant comparison"}>
  <div class="compare__items"><slot /></div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .compare__items {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }
</style>
