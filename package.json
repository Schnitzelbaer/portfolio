{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/build-private.ts && astro dev",
    "build": "tsx scripts/build-private.ts && astro build && tsx scripts/vercel-routes.ts",
    "check": "astro check && biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check:drafts": "tsx scripts/check-drafts.ts",
    "import:notion": "tsx scripts/import-notion.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "showcases:fallbacks": "tsx scripts/showcase-fallbacks.ts",
    "variant:new": "tsx scripts/variant-new.ts",
    "build:private": "tsx scripts/build-private.ts",
    "preview": "tsx scripts/preview-server.ts",
    "password:hash": "tsx scripts/password-hash.ts",
    "test:e2e": "SITE_DOMAIN=portfolio.localhost ROUTING_PRODUCTION=1 npm run build && playwright test",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/vercel": "^11.0.16",
    "acorn": "^8.19.0",
    "astro": "^7.4.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "unist-util-visit-parents": "^6.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.2",
    "@playwright/test": "1.63.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/unist": "^3.0.3",
    "lighthouse": "^13.5.0",
    "mdast-util-mdx": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
