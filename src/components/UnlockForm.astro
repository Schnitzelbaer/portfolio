---
import Icon from "./Icon.astro";

/**
 * Password form for protected case studies. Plain HTML POST to /api/unlock, so it works
 * without JavaScript. One password unlocks all protected work on this site.
 */
interface Props {
  title?: string;
  /** Adds the `#unlock` anchor (use once per page). */
  anchor?: boolean;
}
const { title = "This case study is password protected", anchor = true } = Astro.props;
const status = Astro.url.searchParams.get("unlock");
const next = Astro.url.pathname;
const message =
  status === "failed"
    ? "That password did not work. Please check it and try again."
    : status === "throttled"
      ? "Too many attempts. Please wait a few minutes and try again."
      : undefined;
const inputId = `password-${Math.random().toString(36).slice(2, 8)}`;
---

<form class="unlock" method="post" action="/api/unlock" id={anchor ? "unlock" : undefined}>
  <span class="unlock__icon"><Icon name="lock" size={16} /></span>
  <div class="unlock__body">
    <p class="unlock__title">{title}</p>
    <p class="unlock__note">Enter the password from my application to see all protected work.</p>
    <input type="hidden" name="next" value={next} />
    <div class="unlock__row">
      <label class="visually-hidden" for={inputId}>Password</label>
      <input
        id={inputId}
        class="unlock__input"
        type="password"
        name="password"
        autocomplete="current-password"
        placeholder="Password"
        required
        aria-invalid={message ? "true" : undefined}
        aria-describedby={message ? `${inputId}-error` : undefined}
      />
      <button class="unlock__button" type="submit">Unlock</button>
    </div>
    {message && <p class="unlock__error" id={`${inputId}-error`} role="alert">{message}</p>}
  </div>
</form>

<style>
  .unlock {
    display: flex;
    gap: 0.875rem;
    align-items: flex-start;
    padding: 1.25rem;
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.03), 0 0 0 1px var(--border);
    scroll-margin-top: 2rem;
  }
  .unlock__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--surface-strong);
    color: var(--text);
  }
  .unlock__body {
    flex: 1;
    min-width: 0;
  }
  .unlock__title {
    color: var(--text);
    font-weight: 600;
  }
  .unlock__note {
    margin-top: 0.125rem;
    color: var(--text-muted);
    font-size: var(--text-ui);
  }
  .unlock__row {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .unlock__input {
    flex: 1;
    min-width: 0;
    height: 2.5rem;
    padding: 0 0.875rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-strong);
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: var(--text-ui);
  }
  .unlock__input::placeholder {
    color: var(--text-subtle);
  }
  .unlock__input:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 1px;
  }
  .unlock__input[aria-invalid="true"] {
    border-color: #e5484d;
  }
  .unlock__button {
    height: 2.5rem;
    padding: 0 1.125rem;
    border-radius: var(--radius-pill);
    background: var(--text);
    color: var(--bg);
    font-weight: 600;
    font-size: var(--text-ui);
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .unlock__button:hover {
    opacity: 0.88;
  }
  .unlock__error {
    margin-top: 0.625rem;
    color: #ff8589;
    font-size: var(--text-sm);
  }
  :global([data-theme="light"]) .unlock__error {
    color: #c62a2f;
  }
</style>
