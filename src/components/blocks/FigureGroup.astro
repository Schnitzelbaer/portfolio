---
/** Several figures side by side with one shared caption. */
interface Props {
  caption?: string;
  columns?: 2 | 3;
}
const { caption, columns = 2 } = Astro.props;
---

<figure class="block figure-group is-wide" style={`--columns: ${columns}`}>
  <div class="figure-group__items"><slot /></div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure-group__items {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
  }
  .figure-group__items > :global(.figure) {
    margin: 0;
  }
  @media (max-width: 34rem) {
    .figure-group__items {
      grid-template-columns: 1fr;
    }
  }
</style>
