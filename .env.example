# Apex domain of the site. Locally use a *.localhost name so subdomains resolve without setup.
SITE_DOMAIN=portfolio.localhost
# Case study password: run `npm run password:hash` and paste both lines here and in Vercel.
# Without them, `npm run dev` uses the password "preview" and production unlocks nothing.
LOCK_PASSWORD_HASH=
LOCK_COOKIE_SECRET=
# Set to 1 to allow production builds with open draft placeholders ([Screen: …], […]).
ALLOW_DRAFTS=0
