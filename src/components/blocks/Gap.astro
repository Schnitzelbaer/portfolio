---
/** Open spot written as `[...]` in Notion (a missing number or learning). Highlighted in dev. */
const dev = import.meta.env.DEV;
---

{
  dev ? (
    <mark class="gap" data-draft="gap" title="Open placeholder">
      […]
    </mark>
  ) : (
    <span class="gap-plain">[…]</span>
  )
}

<style>
  .gap {
    padding: 0 0.3em;
    border-radius: 4px;
    background: var(--draft-surface);
    color: var(--draft);
    outline: 1px dashed var(--draft);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
</style>
