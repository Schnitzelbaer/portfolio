---
import { listShowcases } from "../../lib/showcases";

/**
 * Dev-only page that mounts one showcase variant at its design size, without the tour.
 * `npm run showcases:fallbacks` screenshots it to create the static fallback frames.
 */
export function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  return listShowcases()
    .filter((s) => !s.locked)
    .map((s) => ({ params: { id: s.id }, props: { variants: s.config.variants } }));
}

const { id } = Astro.params;
const { variants } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <style>
      html,
      body {
        margin: 0;
        background: #17161d;
      }
      #stage {
        overflow: hidden;
      }
    </style>
  </head>
  <body>
    <div id="stage" data-id={id} data-variants={JSON.stringify(variants)}></div>
    <script>
      import type { ShowcaseVariant, ShowcaseVariantConfig } from "../../lib/tour/types";
      import "../../styles/base.css";

      const modules = import.meta.glob<{ default: ShowcaseVariant }>("/showcases/*/variants/*.ts");
      const stage = document.getElementById("stage") as HTMLElement;
      const variants = JSON.parse(stage.dataset.variants ?? "[]") as ShowcaseVariantConfig[];
      const name = new URLSearchParams(location.search).get("variant") ?? variants[0]?.name;
      const variant = variants.find((v) => v.name === name);
      const loader = modules[`/showcases/${stage.dataset.id}/variants/${name}.ts`];
      if (variant && loader) {
        stage.style.width = `${variant.size[0]}px`;
        stage.style.height = `${variant.size[1]}px`;
        const host = document.createElement("div");
        host.style.cssText = "width:100%;height:100%";
        stage.append(host);
        const mod = await loader();
        mod.default.mount(host.attachShadow({ mode: "open" }));
        await document.fonts.ready;
        document.body.dataset.ready = "true";
      }
    </script>
  </body>
</html>
