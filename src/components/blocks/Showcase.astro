---
/**
 * Embeds a code-based tour animation from `showcases/<id>/`.
 * Phase (c) adds the tour runtime; until then the static fallback frame is shown.
 */
interface Props {
  id: string;
  caption?: string;
}
const { id, caption } = Astro.props;
---

<figure class="block showcase is-wide" data-showcase={id}>
  <div class="showcase__frame media" role="img" aria-label={`Showcase: ${caption ?? id}`}></div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .showcase__frame {
    aspect-ratio: 16 / 10;
  }
</style>
