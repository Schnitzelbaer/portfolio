---
import GatedRoute from "../../../../components/GatedRoute.astro";
import { markdownResponse } from "../../../../lib/agent/markdown";
import { caseStudyDocument, wantsMarkdown } from "../../../../lib/agent/pages";
import { resolveGatedPage } from "../../../../lib/gate";

/**
 * Same as `src/pages/work/[...gated].astro`, reached through the subdomain rewrite. Its main job
 * is to make Vercel route `/v/<id>/work/*` misses to the server function.
 */
export const prerender = false;

const page = await resolveGatedPage(Astro.params.gated, Astro.params.variant);
// Markdown for `.md` URLs, `Accept: text/markdown` and known AI agents (same gate applies).
if (page && (page.markdownPath || wantsMarkdown(Astro.request))) {
  const response = markdownResponse(caseStudyDocument(page.entry, page.context, Astro.locals.unlocked === true), {
    private: true,
  });
  response.headers.set("Vary", "Accept, User-Agent");
  if (page.context.noindex || page.entry.data.locked) response.headers.set("X-Robots-Tag", "noindex, nofollow");
  return response;
}
---

<GatedRoute page={page} />
