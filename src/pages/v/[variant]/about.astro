---
import { getEntry } from "astro:content";
import AboutPage from "../../../components/AboutPage.astro";
import Base from "../../../layouts/Base.astro";
import { pageContext } from "../../../lib/page";
import { getVariants } from "../../../lib/variants";

export async function getStaticPaths() {
  return (await getVariants()).map((variant) => ({ params: { variant: variant.id }, props: { variant } }));
}

const { variant } = Astro.props;
const context = pageContext(variant);
const about = await getEntry("pages", "about");
---

<Base
  title={about?.data.title}
  description={about?.data.description}
  current="about"
  noindex={context.noindex}
  ogImage={`${context.origin}/og.png`}
  analytics={context.analytics}
>
  <AboutPage />
</Base>
