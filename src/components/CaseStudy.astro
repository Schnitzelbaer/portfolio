---
import { Image } from "astro:assets";
import { render } from "astro:content";
import type { WorkEntry } from "../lib/work";
import "../styles/prose.css";
import KeyFacts from "./blocks/KeyFacts.astro";
import { blocks } from "./blocks/registry";
import Icon from "./Icon.astro";
import SectionLabel from "./SectionLabel.astro";

/**
 * Case study page body. When `showBody` is false (locked and not unlocked), only the public
 * header is rendered: title, lead, key facts and cover. The body is never rendered then.
 */
interface Props {
  entry: WorkEntry;
  next?: WorkEntry | undefined;
  showBody: boolean;
}
const { entry, next, showBody } = Astro.props;
const { data } = entry;
const Content = showBody ? (await render(entry)).Content : null;
const year = data.date.getFullYear();
---

<article class="case">
  <header class="case__head column">
    <div class="case__eyebrow reveal" style="--i: 0">
      <SectionLabel as="p">Case study</SectionLabel>
      <span class="mono">{year}</span>
    </div>
    <h1 class="case__title reveal" style="--i: 1">
      {data.title}
      {data.locked && <Icon name="lock" size={18} class="case__lock" label="Password protected" />}
    </h1>
    <p class="case__lead reveal" style="--i: 2">{data.lead}</p>
    <div class="case__facts reveal" style="--i: 3"><KeyFacts {...data.keyFacts} /></div>
  </header>

  <div class="case__cover wide reveal" style="--i: 4">
    <div class="media">
      <Image
        src={data.cover}
        alt={data.coverAlt}
        widths={[480, 800, 1200, 1600]}
        sizes="(min-width: 788px) 740px, calc(100vw - 48px)"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>

  {
    Content ? (
      <div class="prose case__body">
        <Content components={blocks} />
      </div>
    ) : (
      <div class="case__gate column">
        <slot name="gate" />
      </div>
    )
  }

  {
    next && (
      <nav class="case__next column" aria-label="Next case study">
        <a href={`/work/${next.id}`} class="next">
          <span class="mono">Next case study</span>
          <span class="next__title">
            {next.data.title}
            {next.data.locked && <Icon name="lock" size={14} label="Password protected" />}
          </span>
          <Icon name="arrowUpRight" size={16} class="next__arrow" />
        </a>
      </nav>
    )
  }
</article>

<style>
  /* Case studies read in a wider column than the list and About; wide blocks match it. */
  .case {
    --col: 46.25rem;
    --col-wide: 46.25rem;
    padding-top: 3.75rem;
  }
  .case__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }
  .case__title {
    margin-top: 1rem;
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
  }
  .case__title :global(.case__lock) {
    display: inline-block;
    margin-left: 0.4em;
    vertical-align: -0.08em;
    color: var(--text-muted);
  }
  .case__lead {
    margin-top: 0.75rem;
    color: var(--text-muted);
    font-size: var(--text-lg);
    line-height: 1.5;
    letter-spacing: -0.01em;
  }
  .case__facts {
    margin-top: 2rem;
  }
  .case__cover {
    margin-top: 2.5rem;
  }
  .case__body {
    margin-top: 1rem;
  }
  .case__gate {
    margin-top: 2.5rem;
  }
  .case__next {
    margin-top: 4.5rem;
  }
  .next {
    position: relative;
    display: grid;
    gap: 0.375rem;
    padding: 1.25rem 3rem 1.25rem 1.25rem;
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--border);
    transition: background var(--duration-fast) var(--ease-out);
  }
  .next:hover {
    background: var(--surface-hover);
  }
  .next__title {
    color: var(--text);
    font-weight: 600;
  }
  .next__title :global(svg) {
    display: inline-block;
    margin-left: 0.4em;
    vertical-align: -0.1em;
    color: var(--text-muted);
  }
  :global(.next__arrow) {
    position: absolute;
    right: 1.25rem;
    top: 50%;
    translate: 0 -50%;
    color: var(--text-muted);
    transition: transform var(--duration-fast) var(--ease-out);
  }
  .next:hover :global(.next__arrow) {
    transform: translate(2px, -2px);
    color: var(--text);
  }
</style>
