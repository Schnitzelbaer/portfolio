---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import LockedMedia from "./LockedMedia.astro";

/**
 * Single image with caption. `src` is set by the content pipeline: an imported image for public
 * content, or a `privateId` for images that stay behind the password gate.
 */
interface Props {
  src?: ImageMetadata;
  privateId?: string;
  alt: string;
  caption?: string;
  size?: "content" | "wide" | "full";
}
const { src, privateId, alt, caption, size = "content" } = Astro.props;
const sizes = size === "full" ? "100vw" : "(min-width: 688px) 640px, calc(100vw - 48px)";
const widths = [480, 640, 960, 1280, 1920].filter((w) => !src || w <= src.width);
---

<figure class:list={["block", "figure", { "is-wide": size === "wide", "is-full": size === "full" }]}>
  <div class="media">
    {
      src ? (
        <Picture src={src} alt={alt} formats={["avif", "webp"]} widths={widths} sizes={sizes} />
      ) : privateId ? (
        <LockedMedia id={privateId} alt={alt} />
      ) : null
    }
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
