---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import LockedMedia from "./LockedMedia.astro";

/**
 * Single image with caption. `src` is set by the content pipeline: an imported image for public
 * content, or a `privateId` for images that stay behind the password gate.
 */
interface Props {
  src?: ImageMetadata;
  privateId?: string;
  alt: string;
  caption?: string;
  size?: "content" | "wide" | "full";
}
const { src, privateId, alt, caption, size = "content" } = Astro.props;
const sizes =
  size === "full" ? "100vw" : size === "wide" ? "(min-width: 1200px) 1100px, 100vw" : "(min-width: 760px) 680px, 100vw";
---

<figure class:list={["block", "figure", `figure--${size}`]}>
  {
    src ? (
      <Picture src={src} alt={alt} formats={["avif", "webp"]} widths={[480, 800, 1200, 1600, 2200].filter((w) => w <= src.width)} sizes={sizes} />
    ) : privateId ? (
      <LockedMedia id={privateId} alt={alt} />
    ) : null
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>
